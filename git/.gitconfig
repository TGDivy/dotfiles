[core]
    editor       = nvim
    autocrlf     = input
    excludesfile = ~/.gitignore_global
    pager        = delta

[init]
    defaultBranch = main

[pull]
    rebase = true

[rebase]
    autoStash = true

[merge]
    conflictstyle = zdiff3   # better 3-way merge view

[diff]
    algorithm     = histogram
    colorMoved    = default

[fetch]
    prune         = true
    prunetags     = true

[push]
    autoSetupRemote = true
    followTags      = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[rerere]
    enabled = true            # remember conflict resolutions

[column]
    ui = auto

# ── delta (pretty diffs) ──────────────────────────────────────────────────────
[delta]
    navigate         = true
    light            = false
    side-by-side     = false
    line-numbers     = true
    syntax-theme     = Catppuccin-mocha

[interactive]
    diffFilter = delta --color-only

# ── aliases ───────────────────────────────────────────────────────────────────
[alias]
    lg   = log --oneline --graph --decorate --all
    st   = status -sb
    sw   = switch
    cp   = cherry-pick
    undo = reset HEAD~1 --mixed
    wip  = "!git add -A && git commit -m 'wip'"
    unwip = reset HEAD~1 --mixed

# ── profile include (personal vs work) ────────────────────────────────────────
# Loaded by install.sh which writes the right gitconfig path here.
# The [includeIf] approach works per-directory — useful if you mix
# personal and work repos on the same machine.
[include]
    path = ~/.config/git/active-profile.gitconfig

# ── per-directory overrides (optional — fill in your paths) ──────────────────
# Uncomment to auto-switch identity based on repo path:
# [includeIf "gitdir:~/bloomberg/"]
#     path = ~/.dotfiles/git/profiles/work.gitconfig
# [includeIf "gitdir:~/projects/"]
#     path = ~/.dotfiles/git/profiles/personal.gitconfig
